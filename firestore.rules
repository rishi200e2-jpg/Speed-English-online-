rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Supports UID and Email with proper null checks
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == userId)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == "sd504212@gmail.com") ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == "admin@speedenglish.local") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isNotBlocked() {
      return !isAuthenticated() || (
        isAdmin() ||
        !(
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == true ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "blocked")
        )
      );
    }

    // ==========================================
    // 1. Categories Collection (Global Content)
    // ==========================================
    match /categories/{categoryId} {
      allow read, create, update, delete: if isNotBlocked();
    }

    // ==========================================
    // 2. Quizzes Collection & Subcollections (Global Content)
    // ==========================================
    match /quizzes/{quizId} {
      allow read, create, update, delete: if isNotBlocked();

      // Subcollection: Questions under Quiz
      match /questions/{questionId} {
        allow read, create, update, delete: if isNotBlocked();
      }
    }

    // ==========================================
    // 3. Questions Top-Level Collection (Global Content)
    // ==========================================
    match /questions/{questionId} {
      allow read, create, update, delete: if isNotBlocked();
    }

    // ==========================================
    // 4. Users Collection & User-Specific Data
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isNotBlocked();
      allow create: if isOwner(userId) || isAuthenticated();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      // User's own progress subcollection
      match /progress/{progressId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      }

      // User's own attempts subcollection
      match /attempts/{attemptId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      }
    }

    // ==========================================
    // 5. Live Progress Collection
    // ==========================================
    match /liveProgress/{userId} {
      allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      match /quizzes/{quizId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      }
    }

    // ==========================================
    // 6. Top-Level Attempts Collection (Historical Attempt Records)
    // ==========================================
    match /attempts/{attemptId} {
      allow read, write: if isNotBlocked();
    }

    // ==========================================
    // 7. Admin Logs & Question Audit Logs (Admin Only)
    // ==========================================
    match /adminLogs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /question_audit_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ==========================================
    // 8. Social Posts Collection (Feed & Admin Management)
    // ==========================================
    match /social_posts/{postId} {
      // Anyone (every learner, user, and guest) can read posts
      allow read: if true;
      // Admins and authenticated users can create, update, and delete posts
      allow create, delete: if isNotBlocked();
      // Counter updates (likes, shares, views) and public engagement
      allow update: if true;
    }

    // ==========================================
    // 9. Contact Methods Collection (Dynamic Contact Us)
    // ==========================================
    match /contact_methods/{contactId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    // ==========================================
    // 10. Application Configuration & Metadata (Lightweight SSoT)
    // ==========================================
    match /app_config/content_metadata {
      allow read: if true;
      allow write, create, update, delete: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    match /app_config/social_destination {
      // All learners can read the active destination
      allow read: if true;
      // Strictly Admin only for creating, updating, disabling, and deleting
      allow create, update, delete: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    match /app_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    match /content_metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isNotBlocked();
    }
  }
}
