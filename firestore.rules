rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNotBlocked() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "sd504212@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // ==========================================
    // 1. Categories Collection (Global Content)
    // ==========================================
    match /categories/{categoryId} {
      // Normal users: Read published categories only; Admins: Read all (including drafts)
      allow read: if isNotBlocked() && (resource == null || resource.data.isDraft == false || resource.data.status == "published" || isAdmin());
      // Admin only: Full write/create/update/delete permissions
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 2. Quizzes Collection & Subcollections (Global Content)
    // ==========================================
    match /quizzes/{quizId} {
      // Normal users: Read published quizzes only; Admins: Read all
      allow read: if isNotBlocked() && (resource == null || resource.data.isDraft == false || resource.data.status == "published" || isAdmin());
      // Admin only: Full write/create/update/delete permissions
      allow create, update, delete: if isAdmin();

      // Subcollection: Questions under Quiz
      match /questions/{questionId} {
        // Authenticated users have read-only access to questions
        allow read: if isNotBlocked();
        // Admin only: Full write/create/update/delete permissions
        allow create, update, delete: if isAdmin();
      }
    }

    // ==========================================
    // 3. Questions Top-Level Collection (Global Content)
    // ==========================================
    match /questions/{questionId} {
      // Authenticated users have read-only access to questions
      allow read: if isNotBlocked();
      // Admin only: Full write/create/update/delete permissions
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 4. Users Collection & User-Specific Data
    // ==========================================
    match /users/{userId} {
      // Users can read only their own profile; Admins can inspect all profiles
      allow read: if (isOwner(userId) && isNotBlocked()) || isAdmin();
      
      // User Profile Creation (e.g., initial registration)
      allow create: if isOwner(userId) 
        && request.resource.data.role == "user" 
        && request.resource.data.blocked == false;

      // User Profile Updates: Normal users cannot elevate role or unblock themselves
      allow update: if isAdmin() || (
        isOwner(userId)
        && isNotBlocked()
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.blocked == resource.data.blocked
      );

      // Deleting user profiles: Admin only
      allow delete: if isAdmin();

      // User's own progress subcollection: Strictly isolated to owner
      match /progress/{progressId} {
        allow read, write, delete: if (isOwner(userId) && isNotBlocked()) || isAdmin();
      }

      // User's own attempts subcollection: Strictly isolated to owner
      match /attempts/{attemptId} {
        allow read, write, delete: if (isOwner(userId) && isNotBlocked()) || isAdmin();
      }
    }

    // ==========================================
    // 5. Live Progress Collection
    // ==========================================
    match /liveProgress/{userId} {
      allow read, write, delete: if (isOwner(userId) && isNotBlocked()) || isAdmin();
      match /quizzes/{quizId} {
        allow read, write, delete: if (isOwner(userId) && isNotBlocked()) || isAdmin();
      }
    }

    // ==========================================
    // 6. Top-Level Attempts Collection (Historical Attempt Records)
    // ==========================================
    match /attempts/{attemptId} {
      allow read: if isNotBlocked() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isNotBlocked() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isNotBlocked() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // 7. Admin Logs & Question Audit Logs (Admin Only)
    // ==========================================
    match /adminLogs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /question_audit_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
