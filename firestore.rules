rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Supports UID, Email, and Sanitized Email with proper null checks
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == userId) ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email.replace(".", "_") == userId)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == "sd504212@gmail.com") ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == "admin@speedenglish.local") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (request.auth.token != null && 'email' in request.auth.token && 
         exists(/databases/$(database)/documents/users/$(request.auth.token.email.replace(".", "_"))) && 
         get(/databases/$(database)/documents/users/$(request.auth.token.email.replace(".", "_"))).data.role == "admin")
      );
    }

    function isNotBlocked() {
      return !isAuthenticated() || (
        isAdmin() ||
        !(
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "blocked"))
          ||
          (request.auth.token != null && 'email' in request.auth.token && 
           exists(/databases/$(database)/documents/users/$(request.auth.token.email.replace(".", "_"))) && 
           (get(/databases/$(database)/documents/users/$(request.auth.token.email.replace(".", "_"))).data.blocked == true ||
            get(/databases/$(database)/documents/users/$(request.auth.token.email.replace(".", "_"))).data.status == "blocked"))
        )
      );
    }

    // ==========================================
    // 1. Categories Collection (Global Content)
    // ==========================================
    match /categories/{categoryId} {
      allow read, create, update, delete: if isNotBlocked();
    }

    // ==========================================
    // 2. Quizzes Collection & Subcollections (Global Content)
    // ==========================================
    match /quizzes/{quizId} {
      allow read, create, update, delete: if isNotBlocked();

      // Subcollection: Questions under Quiz
      match /questions/{questionId} {
        allow read, create, update, delete: if isNotBlocked();
      }
    }

    // ==========================================
    // 3. Questions Top-Level Collection (Global Content)
    // ==========================================
    match /questions/{questionId} {
      allow read, create, update, delete: if isNotBlocked();
    }

    // ==========================================
    // 4. Users Collection & User-Specific Data
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isNotBlocked();
      allow create: if isOwner(userId) || isAuthenticated();
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.blocked == resource.data.blocked
      );
      allow delete: if isAdmin();

      // User's own progress subcollection
      match /progress/{progressId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      }

      // User's own attempts subcollection
      match /attempts/{attemptId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      }
    }

    // ==========================================
    // 5. Live Progress Collection
    // ==========================================
    match /liveProgress/{userId} {
      allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      match /quizzes/{quizId} {
        allow read, write, delete: if isOwner(userId) || isAdmin() || isNotBlocked();
      }
    }

    // ==========================================
    // 6. Top-Level Attempts Collection (Historical Attempt Records)
    // ==========================================
    match /attempts/{attemptId} {
      allow read, write: if isNotBlocked();
    }

    // ==========================================
    // 7. Admin Logs & Question Audit Logs (Admin Only)
    // ==========================================
    match /adminLogs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /question_audit_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
