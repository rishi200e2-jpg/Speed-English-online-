rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // HELPER FUNCTIONS
    // ========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (
          request.auth.token != null &&
          'email' in request.auth.token &&
          request.auth.token.email == userId
        ) ||
        (
          request.auth.token != null &&
          'email' in request.auth.token &&
          request.auth.token.email.replace(".", "_") == userId
        )
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (
          request.auth.token != null &&
          'email' in request.auth.token &&
          request.auth.token.email == "sd504212@gmail.com"
        ) ||
        (
          request.auth.token != null &&
          'email' in request.auth.token &&
          request.auth.token.email == "admin@speedenglish.local"
        ) ||
        (
          exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ) &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "admin"
        ) ||
        (
          request.auth.token != null &&
          'email' in request.auth.token &&
          exists(
            /databases/$(database)/documents/users/$(
              request.auth.token.email.replace(".", "_")
            )
          ) &&
          get(
            /databases/$(database)/documents/users/$(
              request.auth.token.email.replace(".", "_")
            )
          ).data.role == "admin"
        )
      );
    }


    // ========================================================
    // 1. CATEGORIES (Public Read, Admin Write)
    // ========================================================

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // ========================================================
    // 2. QUIZZES & QUESTIONS (Public Read, Admin Write)
    // ========================================================

    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }


    // ========================================================
    // 3. TOP-LEVEL QUESTIONS
    // ========================================================

    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // ========================================================
    // 4. USERS & PROFILES
    // ========================================================

    match /users/{userId} {
      // Allows viewing public user profile details for social feed & leaderboards
      allow read: if true;

      allow create: if isOwner(userId);

      // Users can update their profile info, but cannot change role, status, or blocked state
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.blocked == resource.data.blocked
      );

      allow delete: if isAdmin();


      // ------------------------------------------------------
      // USER PROGRESS (Strict Owner Privacy)
      // ------------------------------------------------------

      match /progress/{progressId} {
        allow read, write, delete:
          if isOwner(userId) || isAdmin();
      }


      // ------------------------------------------------------
      // USER ATTEMPTS (Strict Owner Privacy)
      // ------------------------------------------------------

      match /attempts/{attemptId} {
        allow read, write, delete:
          if isOwner(userId) || isAdmin();
      }
    }


    // ========================================================
    // 5. LIVE PROGRESS
    // ========================================================

    match /liveProgress/{userId} {
      allow read, write, delete:
        if isOwner(userId) || isAdmin();

      match /quizzes/{quizId} {
        allow read, write, delete:
          if isOwner(userId) || isAdmin();
      }
    }


    // ========================================================
    // 6. TOP-LEVEL HISTORICAL ATTEMPTS
    // ========================================================

    match /attempts/{attemptId} {
      allow read, write:
        if isAuthenticated() || isAdmin();
    }


    // ========================================================
    // 7. ADMIN LOGS
    // ========================================================

    match /adminLogs/{logId} {
      allow read, create, update, delete:
        if isAdmin();
    }


    // ========================================================
    // 8. QUESTION AUDIT LOGS
    // ========================================================

    match /question_audit_logs/{logId} {
      allow read, create, update, delete:
        if isAdmin();
    }


    // ========================================================
    // 9. SOCIAL POSTS (Posts, Media, Likes, Views, Shares)
    // ========================================================

    match /social_posts/{postId} {

      // Public posts can be read by everyone (guests, users, and admins)
      allow read: if true;

      // Logged-in users and admins can create posts
      allow create: if isAuthenticated();

      // Logged-in users can update likes, views, and shares on posts
      allow update: if isAuthenticated();

      // Admin can delete any post; User can delete their own post
      allow delete: if isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.authorId == request.auth.uid
        );


      // ======================================================
      // POST SUBCOLLECTIONS (Comments, Likes, Shares)
      // ======================================================

      match /{subcollection=**} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }
    }


    // ========================================================
    // 10. CONTACT METHODS (Public Read, Admin Write)
    // ========================================================

    match /contact_methods/{contactId} {
      // All learners can read contact methods without requiring login
      allow read: if true;
      // Strictly Admin only can create, edit, toggle, or delete contact methods
      allow create, update, delete: if isAdmin();
    }


    // ========================================================
    // 11. APPLICATION CONFIGURATION & METADATA
    // ========================================================

    // Single shared metadata doc: checks versions before downloading actual configs
    match /app_config/content_metadata {
      // All users can read version numbers for lightweight sync
      allow read: if true;
      // Only Admin can increment version numbers
      allow write: if isAdmin();
    }

    // Post Destination configuration document
    match /app_config/social_destination {
      // All learners can read the active destination
      allow read: if true;
      // Strictly Admin only for saving, updating, disabling, and deleting
      allow write: if isAdmin();
    }

    // General app_config fallback
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
