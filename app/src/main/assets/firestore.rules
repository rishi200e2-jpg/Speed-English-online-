rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Supports UID and Email with proper null checks
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == userId)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == "sd504212@gmail.com") ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == "admin@speedenglish.local") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // ==========================================
    // 1. Categories Collection (Global Content)
    // ==========================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 2. Quizzes Collection & Subcollections (Global Content)
    // ==========================================
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Subcollection: Questions under Quiz
      match /questions/{questionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // ==========================================
    // 3. Questions Top-Level Collection (Global Content)
    // ==========================================
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 4. Users Collection & User-Specific Data
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      // User's own progress subcollection
      match /progress/{progressId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // User's own attempts subcollection
      match /attempts/{attemptId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ==========================================
    // 5. Live Progress Collection
    // ==========================================
    match /liveProgress/{userId} {
      allow read, write, delete: if isOwner(userId) || isAdmin();
      match /quizzes/{quizId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ==========================================
    // 6. Top-Level Attempts Collection (Historical Attempt Records)
    // ==========================================
    match /attempts/{attemptId} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    // ==========================================
    // 7. Admin Logs & Question Audit Logs (Admin Only)
    // ==========================================
    match /adminLogs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /question_audit_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ==========================================
    // 8. Social Posts Collection (Feed & Admin Management)
    // ==========================================
    match /social_posts/{postId} {
      // Anyone (every learner and guest) can read posts
      allow read: if true;
      // Admins and authenticated users can create, update, and delete posts
      allow create, delete: if isAdmin() || isAuthenticated();
      // Counter updates (likes, shares, views) and admin modifications
      allow update: if true;
    }
  }
}
